# Node Environment
NODE_ENV=development
PORT=3000

# Azure SQL Database (Microsoft SQL Server)
# Format: sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<pass>;encrypt=true;trustServerCertificate=false
DATABASE_URL="sqlserver://localhost:1433;database=varnak;user=sa;password=YourStrong!Password123;encrypt=true;trustServerCertificate=true"

# Azure Blob Storage (or Azurite local emulator)
AZURE_STORAGE_ACCOUNT_NAME="devstoreaccount1"
AZURE_STORAGE_ACCOUNT_KEY="Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw=="
AZURE_STORAGE_CONTAINER_NAME="project-images"
AZURE_STORAGE_GENERATED_CONTAINER_NAME="generated-images"

# Redis (or local container)
REDIS_URL="redis://localhost:6379"

# Microsoft Entra External ID (OIDC)
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_SECRET="your-entra-client-secret-placeholder"
NEXTAUTH_SECRET="super-secret-nextauth-encryption-key-min-16-chars"
NEXTAUTH_URL="http://localhost:3000"

# AI Vision & Visualization (Google Gemini)
GEMINI_API_KEY="your-gemini-api-key"
IMAGE_ANALYSIS_MODEL="gemini-1.5-pro"

# Geocoding & Places APIs (Google Maps Platform)
GOOGLE_GEOCODING_API_KEY="your-google-geocoding-api-key"
GOOGLE_PLACES_API_KEY="your-google-places-api-key"

# Transactional Email Service
EMAIL_PROVIDER="console" # Options: sendgrid, azure_communication, smtp, console
EMAIL_API_KEY="your-email-provider-api-key"
EMAIL_FROM_ADDRESS="no-reply@varnak.in"
